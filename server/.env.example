# Скопируй в .env и заполни реальными значениями. .env в git не коммитится (см. .gitignore).

# Ключ авторизации (OAuth app) основного портала bot24.bitrix24.ru.
# Выпускается в разделе "Ключи авторизации" на vibecode.bitrix24.tech.
VIBE_APP_KEY=vibe_app_...

VIBE_API_BASE_URL=https://vibecode.bitrix24.tech

# Публичный URL ЭТОГО backend после деплоя на Black Hole/galaxy.
# Нужен для placement handler и OAuth redirect_uri (см. scripts/bind_placement.py).
APP_BASE_URL=

PLACEMENT_TITLE=Message Aggregator

# Этап 2 — заполнится позже.
DATABASE_URL=sqlite:///./db/app.db
CREDENTIALS_ENCRYPTION_KEY=
